# Conexión PostgreSQL (Neon o estándar). NO subas credenciales reales.
DATABASE_URL=postgresql://usuario:password@host:5432/basedatos?sslmode=require

# Worker programado de alertas (cron). Cabecera x-worker-secret o ?secreto=.
WORKER_SECRET=cambia-este-secreto-largo-y-aleatorio

# Endpoints internos (/api/internal/*) y crons (/api/cron/*). Nunca exponer sin autenticación.
# Se acepta cualquiera de estas cabeceras: x-internal-secret, x-worker-secret,
# x-cron-secret, x-service-account-token, Authorization: Bearer <secreto>, o ?secret=.
INTERNAL_SECRET=cambia-este-secreto-interno-largo-y-aleatorio
CRON_SECRET=cambia-este-secreto-cron-largo-y-aleatorio
# Panel interno TecRural (/admin y /api/admin/*). Solo administradores.
ADMIN_SECRET=cambia-este-secreto-admin-largo-y-aleatorio

# Firma de las cookies de sesión (dispositivo anónimo y cuenta de usuario).
# Si falta, se usa INTERNAL_SECRET/ADMIN_SECRET como respaldo (no recomendado).
DEVICE_SESSION_SECRET=cambia-este-secreto-de-sesion-largo-y-aleatorio
# Opcional: token de cuenta de servicio (si se usa service account en lugar de secret).
# INTERNAL_SERVICE_ACCOUNT_TOKEN=

# Canal Telegram (BotFather).
TELEGRAM_BOT_TOKEN=
# Chat de Telegram del equipo comercial para recibir solicitudes de contacto.
# (Escríbele al bot y obtén el chat_id, p. ej. con getUpdates.)
TELEGRAM_CHAT_ID_NEGOCIO=

# Canal correo (Resend).
RESEND_API_KEY=
EMAIL_FROM=TecRural <mcgtecrural@gmail.com>

# Canal WhatsApp (Cloud API).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Contacto comercial visible en la web (público, con prefijo NEXT_PUBLIC_).
# Formato recomendado: +34600000000 (sin espacios para WhatsApp).
NEXT_PUBLIC_TECRURAL_TELEFONO=
NEXT_PUBLIC_TECRURAL_WHATSAPP=

# Dominio HTTPS canónico usado por metadata, sitemap y robots.txt.
# En producción debe ser el dominio definitivo, sin barra final.
NEXT_PUBLIC_SITE_URL=https://tecrural.es

# Canal push (Web Push / VAPID). Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mcgtecrural@gmail.com

# Proveedores de datos (jerarquía: AEMET principal, Open-Meteo respaldo del MVP,
# SiAR agroclimático, RAIF fitosanitario). Sin credenciales, solo Open-Meteo.
AEMET_API_KEY=
AEMET_MUNICIPIO=
AEMET_AREA=
SIAR_BASE_URL=
SIAR_ESTACION=
SIAR_TOKEN=
# RIA (si aplica)
RIA_TOKEN=
RAIF_FEED_URL=https://raif-gamma.vercel.app/
RAIF_TOKEN=
RAIF_API_KEY=
OPENCLAW_RAIF_TOKEN=
